run = "bash scripts/run-replit.sh"
modules = ["python-3.11"]

[deployment]
build = [
  "bash",
  "-c",
  "export PIP_USER=0; python -m venv .venv && .venv/bin/python -m pip install --upgrade pip && .venv/bin/python -m pip install --no-cache-dir -r requirements.txt"
]
run = ["bash", "scripts/run-replit.sh"]
deploymentTarget = "cloudrun"

[[ports]]
localPort = 8501
externalPort = 80

